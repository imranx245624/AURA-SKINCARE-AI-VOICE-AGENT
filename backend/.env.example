# Aura Skincare Voice Agent - Backend Configuration

# Server Port
PORT=5000

# Google Gemini API Key (Get one from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL for CORS configuration (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173
